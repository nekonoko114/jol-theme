# Discord Bot トークン（Discord Developer Portalで発行したもの）
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google Gemini API キー（Google AI Studioで発行したもの）
GEMINI_API_KEY=your_gemini_api_key_here

# 投稿を監視するDiscordチャンネルID（空欄の場合はBotがいる全チャンネルで反応）
# チャンネルを右クリックして「チャンネルIDをコピー」で取得可能
DISCORD_CHANNEL_ID=

# WordPress REST API 設定
# 本番環境例: https://liver-jol.com/wp-json/jol/v1/event
# ローカル環境例: http://localhost:8888/jol-website/wp-json/jol/v1/event
WP_EVENT_API_URL=https://liver-jol.com/wp-json/jol/v1/event

# WordPress API 認証キー（テーマ内の inc/event-api-receiver.php と一致させる必要があります）
WP_EVENT_API_KEY=jol_event_secret_token_2026
